generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Region {
  region_id Int    @id @default(autoincrement())
  name      String @unique
  cities    City[]
}

model City {
  city_id        Int                    @id @default(autoincrement())
  name           String
  region_id      Int
  region         Region                 @relation(fields: [region_id], references: [region_id])
  establishments EstablishmentProfile[]
  missions       Mission[]
  workers        WorkerProfile[]

  @@unique([name, region_id])
}

model User {
  user_id                Int                   @id @default(autoincrement())
  email                  String                @unique
  password               String
  role                   UserRole
  created_at             DateTime              @default(now())
  email_code             String?
  email_code_expires     DateTime?
  email_verified         Boolean               @default(false)
  reset_password_expires DateTime?
  reset_password_token   String?
  establishmentProfile   EstablishmentProfile?
  notifications          Notification[]
  workerProfile          WorkerProfile?

  @@index([email_code])
  @@index([reset_password_token])
}

model WorkerProfile {
  user_id             Int                @id
  first_name          String?
  last_name           String?
  address             String?
  city_id             Int?
  phone               String?
  bio                 String?
  profile_pic_url     String?
  cv_url              String?
  experience_years    Int?
  title               String?
  verification_status VerificationStatus @default(PENDING)
  applications        Application[]
  availabilities      Availability[]
  diplomas            Diploma[]

  city                City?              @relation(fields: [city_id], references: [city_id])
  user                User               @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  specialities        WorkerSpeciality[]
  conversations       Conversation[]
}

model EstablishmentProfile {
  user_id             Int                @id
  structure_id        Int?
  name                String
  contact_first_name  String
  contact_last_name   String
  contact_function    String?
  ice_number          String             @unique
  rc_number           String?
  address             String?
  city_id             Int?
  phone               String?
  verification_status VerificationStatus @default(PENDING)
  service             String?
  logo_url            String?
  city                City?              @relation(fields: [city_id], references: [city_id])
  structure           Structure?         @relation(fields: [structure_id], references: [id])
  user                User               @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  missions            Mission[]
  conversations       Conversation[]
}

model Structure {
  id             Int                    @id @default(autoincrement())
  label          String                 @unique
  is_active      Boolean                @default(true)
  establishments EstablishmentProfile[]
}



model WorkerSpeciality {
  speciality_id Int
  user_id       Int
  speciality    Speciality    @relation(fields: [speciality_id], references: [speciality_id], onDelete: Cascade)
  worker        WorkerProfile @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, speciality_id])
}



model Diploma {
  diploma_id          Int                @id @default(autoincrement())
  description         String?
  institution         String?
  issue_date          DateTime?
  name                String
  user_id             Int
  verification_status VerificationStatus @default(PENDING)
  created_at          DateTime           @default(now())
  file_url            String
  worker              WorkerProfile      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Availability {
  availability_id   Int           @id @default(autoincrement())
  worker_profile_id Int
  date              DateTime
  status            AvailabilityStatus @default(AVAILABLE)
  worker            WorkerProfile @relation(fields: [worker_profile_id], references: [user_id], onDelete: Cascade)

  @@unique([worker_profile_id, date])
}

enum AvailabilityStatus {
  AVAILABLE
  OCCUPIED
  UNAVAILABLE
  HOLIDAY
}

model Speciality {
  speciality_id Int                @id @default(autoincrement())
  name          String             @unique
  workers       WorkerSpeciality[]

  missions      MissionSpeciality[] 
}



model Mission {
  mission_id       Int                  @id @default(autoincrement())
  title            String
  description      String?
  start_date       DateTime
  end_date         DateTime
  city_id          Int
  establishment_id Int
  status           String
  budget           Float
  created_at       DateTime             @default(now())
  applications     Application[]
  city             City                 @relation(fields: [city_id], references: [city_id])
  establishment    EstablishmentProfile @relation(fields: [establishment_id], references: [user_id], onDelete: Cascade)

  specialities     MissionSpeciality[] 
}

model MissionSpeciality {
  mission_id     Int
  speciality_id  Int

  mission    Mission     @relation(fields: [mission_id], references: [mission_id], onDelete: Cascade)
  speciality Speciality  @relation(fields: [speciality_id], references: [speciality_id], onDelete: Cascade)

  @@id([mission_id, speciality_id])
}

model Application {
  application_id    Int               @id @default(autoincrement())
  worker_profile_id Int
  mission_id        Int
  created_at        DateTime          @default(now())
  status            ApplicationStatus @default(PENDING)
  mission           Mission           @relation(fields: [mission_id], references: [mission_id], onDelete: Cascade)
  worker            WorkerProfile     @relation(fields: [worker_profile_id], references: [user_id], onDelete: Cascade)
  intervention      Intervention?
  ///
  @@unique([worker_profile_id, mission_id])
}

model Intervention {
  intervention_id Int         @id @default(autoincrement())
  application_id  Int         @unique
  feedbacks       Feedback[]
  application     Application @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
}

model Feedback {
  feedback_id     Int          @id @default(autoincrement())
  intervention_id Int
  rating          Int?
  content         String
  intervention    Intervention @relation(fields: [intervention_id], references: [intervention_id], onDelete: Cascade)
}

model Notification {
  notification_id Int              @id @default(autoincrement())
  user_id         Int
  message         String
  created_at      DateTime         @default(now())
  is_read         Boolean          @default(false)
  type            NotificationType
  user            User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Conversation {
  conversation_id  Int      @id @default(autoincrement())
  worker_id        Int
  establishment_id Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  messages         Message[]
  worker           WorkerProfile        @relation(fields: [worker_id], references: [user_id], onDelete: Cascade)
  establishment    EstablishmentProfile @relation(fields: [establishment_id], references: [user_id], onDelete: Cascade)
  
  @@unique([worker_id, establishment_id])
}

model Message {
  message_id      Int      @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  content         String
  created_at      DateTime @default(now())
  is_read         Boolean  @default(false)

  conversation    Conversation @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED_BY_WORKER
  COMPLETED_CONFIRMED
  DISPUTED
}

enum UserRole {
  WORKER
  ESTABLISHMENT
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
}
